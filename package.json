{
  "name": "glass-ui",
  "version": "0.7.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build:packages": "pnpm --filter @lemuayala/glass-ui-core run build && pnpm --filter @lemuayala/glass-ui-mcp run build",
    "dev": "pnpm run build:packages && next dev",
    "build": "pnpm run build:packages && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "pnpm run build:packages && pnpm --filter @lemuayala/glass-ui-mcp run typecheck && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "release:pack": "pnpm run build:packages && pnpm --filter './packages/*' pack --dry-run",
    "release:publish": "pnpm run build:packages && pnpm --filter @lemuayala/glass-ui-core publish --access public --no-git-checks && pnpm --filter @lemuayala/glass-ui-mcp publish --access public --no-git-checks",
    "icons:export": "node scripts/export-app-icons.mjs",
    "smoke:published": "node scripts/smoke-published.mjs"
  },
  "dependencies": {
    "@lemuayala/glass-ui-core": "workspace:*",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@vercel/analytics": "1.6.1",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.564.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "prism-react-renderer": "^2.4.1",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "only-allow": "^1.2.1",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.7.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.2"
  },
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f"
}
